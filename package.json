{
  "name": "muster",
  "version": "0.1.0",
  "private": true,
  "description": "The shared workspace for human and agent-driven security operations.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "contracts:generate": "pnpm --filter @muster/contracts generate",
    "db:generate": "pnpm --filter @muster/database generate",
    "db:migrate": "pnpm --filter @muster/database migrate",
    "db:bootstrap": "pnpm --filter @muster/database bootstrap",
    "db:verify-clean": "pnpm --filter @muster/database verify-clean",
    "db:seed": "pnpm --filter @muster/database seed",
    "screenshots": "playwright test tests/screenshots.spec.ts",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "turbo": "2.10.7",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
