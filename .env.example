NODE_ENV=development
MUSTER_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://muster:muster@localhost:5432/muster
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_SECURE_COOKIES=false
AUTH_RATE_LIMIT_MAX=100
AUTH_SENSITIVE_RATE_LIMIT_MAX=3
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=muster-evidence
OBJECT_STORAGE_ACCESS_KEY=muster
OBJECT_STORAGE_SECRET_KEY=replace-me
MUSTER_LOCAL_ADMIN_EMAIL=admin@muster.local
MUSTER_LOCAL_ADMIN_PASSWORD=replace-me
MUSTER_ORGANISATION_NAME=Muster Workspace
MUSTER_ORGANISATION_SLUG=muster
MUSTER_DEFAULT_TIMEZONE=UTC
KELPIE_BASE_URL=http://localhost:4011
KELPIE_API_TOKEN=mock-kelpie-token
TAWNY_BASE_URL=http://localhost:4012
TAWNY_API_TOKEN=mock-tawny-token
BOWER_BASE_URL=http://localhost:4013
BOWER_API_TOKEN=mock-bower-token
SENTINEL_TENANT_ID=
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_WORKSPACE_ID=
MUSTER_MOCK_INTEGRATIONS=true
# Optional comma-separated HTTPS origins for additional Alfie research feeds.
MUSTER_RESEARCH_ALLOWED_FEED_ORIGINS=
