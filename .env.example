# --- Ops API (apps/ops) — primary surface ---
NODE_ENV=development
MUSTER_OPS_PORT=3010
# Recommended outside local dev:
# MUSTER_OPS_TOKEN=replace-with-long-random-secret

# Mastra model router — see https://mastra.ai/models
MUSTER_MASTRA_MODEL=openai/gpt-5-mini
OPENAI_API_KEY=

# Upstream systems of record (set what you use)
# Endpoint fleet (Tawny-compatible)
TAWNY_BASE_URL=http://127.0.0.1:5000
TAWNY_API_TOKEN=

# Cases / IR (Kelpie-compatible)
KELPIE_BASE_URL=http://127.0.0.1:3000
KELPIE_API_TOKEN=

# Threat intel context (Brolga-compatible)
BROLGA_BASE_URL=http://127.0.0.1:8787
BROLGA_API_TOKEN=

# Thresholds
MUSTER_FLEET_STALE_MINUTES=15
MUSTER_CASE_AGING_HOURS=24

# --- Optional status UI (apps/web) ---
MUSTER_OPS_URL=http://127.0.0.1:3010
# MUSTER_OPS_TOKEN=  # same as above if required
