{
  "name": "@muster/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "development": "./src/client.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.25",
    "@better-auth/passkey": "1.6.25",
    "@muster/database": "workspace:*",
    "better-auth": "1.6.25",
    "nodemailer": "9.0.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  }
}
