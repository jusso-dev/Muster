{
  "name": "@muster/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "create-installation": "tsx src/cli-create-installation.ts",
    "revoke-installation": "tsx src/cli-revoke-installation.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@muster/audit": "workspace:*",
    "@muster/authz": "workspace:*",
    "@muster/config": "workspace:*",
    "@muster/contracts": "workspace:*",
    "@muster/database": "workspace:*",
    "@muster/integrations": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  }
}
