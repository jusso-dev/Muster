{
  "name": "@muster/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "development": "./src/schema.ts",
      "default": "./dist/schema.js"
    },
    "./seed-data": {
      "types": "./src/seed-data.ts",
      "development": "./src/seed-data.ts",
      "default": "./dist/seed-data.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "bootstrap": "tsx src/bootstrap.ts",
    "verify-clean": "tsx src/verify-clean-install.ts",
    "verify:audit": "tsx src/verify-audit-integrity.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@muster/audit": "workspace:*",
    "@muster/authz": "workspace:*",
    "@muster/contracts": "workspace:*",
    "@muster/integrations": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "^8.16.3",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "0.31.10",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  }
}
